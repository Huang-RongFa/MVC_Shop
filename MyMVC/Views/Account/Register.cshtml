@model MyWeb.Models.ViewModels.Auth.RegisterPageViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Title;
}

<section class="auth-card auth-card-wide">
    <a class="brand auth-brand" asp-controller="Home" asp-action="Index">
        <span class="brand-mark">MS</span>
        <span>MVC Shop</span>
    </a>
    <h1>@Model.Title</h1>
    <p>@Model.Subtitle</p>

    <form method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div class="auth-form-grid">
            <div class="form-group">
                <label class="form-label" for="displayName">姓名</label>
                <input id="displayName" name="displayName" class="form-control" maxlength="80" autocomplete="name" required />
            </div>
            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input id="email" name="email" class="form-control" type="email" maxlength="120" autocomplete="email" required />
            </div>
            <div class="form-group">
                <label class="form-label" for="phone">手機</label>
                <input id="phone" name="phone" class="form-control" maxlength="30" autocomplete="tel" />
            </div>
            <div class="form-group">
                <label class="form-label" for="password">密碼</label>
                <input id="password" name="password" class="form-control" type="password" minlength="8" maxlength="200" autocomplete="new-password" required />
            </div>
            <div class="form-group">
                <label class="form-label" for="confirmPassword">確認密碼</label>
                <input id="confirmPassword" name="confirmPassword" class="form-control" type="password" minlength="8" maxlength="200" autocomplete="new-password" required />
            </div>
        </div>
        <label class="checkbox-label terms-row" for="acceptTerms">
            <input id="acceptTerms" name="acceptTerms" type="checkbox" required />
            我同意服務條款與隱私權政策
        </label>
        <button class="btn btn-primary" type="submit" disabled>建立帳號</button>
    </form>

    <p class="auth-footer">
        已有帳號？
        <a asp-controller="Account" asp-action="Login">登入會員</a>
    </p>
</section>
