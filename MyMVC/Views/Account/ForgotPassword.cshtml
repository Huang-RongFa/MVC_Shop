@model MyWeb.Models.ViewModels.Auth.ForgotPasswordPageViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Title;
}

<section class="auth-card">
    <a class="brand auth-brand" asp-controller="Home" asp-action="Index">
        <span class="brand-mark">MS</span>
        <span>MVC Shop</span>
    </a>
    <h1>@Model.Title</h1>
    <p>@Model.Subtitle</p>

    <form method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input id="email" name="email" class="form-control" type="email" maxlength="120" autocomplete="email" required />
        </div>
        <button class="btn btn-primary" type="submit" disabled>寄送重設連結</button>
    </form>

    <p class="auth-footer">
        想起密碼了？
        <a asp-controller="Account" asp-action="Login">返回登入</a>
    </p>
</section>
