@model MyWeb.Models.ViewModels.Auth.AuthLoginPageViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Title;
}

<section class="auth-card">
    <a class="brand auth-brand" asp-controller="Home" asp-action="Index">
        <span class="brand-mark">MS</span>
        <span>MVC Shop</span>
    </a>
    <h1>@Model.Title</h1>
    <p>@Model.Subtitle</p>

    <form method="post" asp-controller="Account" asp-action="Login" class="auth-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Model.PostLoginPath" />
        <div asp-validation-summary="ModelOnly" class="validation-summary text-danger" role="alert"></div>
        <div class="form-group">
            <label class="form-label" for="account">@Model.AccountLabel</label>
            <input id="account" name="account" class="form-control" type="text" maxlength="100" autocomplete="username" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="password">密碼</label>
            <input id="password" name="password" class="form-control" type="password" minlength="8" maxlength="200" autocomplete="current-password" required />
        </div>
        <div class="auth-row">
            <label class="checkbox-label" for="rememberMe">
                <input id="rememberMe" name="rememberMe" type="checkbox" />
                記住我
            </label>
            <a asp-controller="Account" asp-action="ForgotPassword">忘記密碼</a>
        </div>
        <button class="btn btn-primary" type="submit">@Model.SubmitText</button>
    </form>

    <p class="auth-footer">
        還沒有帳號？
        <a asp-controller="Account" asp-action="Register">建立會員帳號</a>
    </p>
</section>
