@model MyWeb.Models.ViewModels.Storefront.CartViewModel
@{
    ViewData["Title"] = "購物車";
}

<header class="page-header storefront-page-header">
    <p class="eyebrow">Cart</p>
    <h1>購物車</h1>
    <p>購物車金額僅供顯示，建立訂單時後端會重新計算價格、優惠與庫存。</p>
</header>

<section class="cart-layout">
    <div class="card cart-items-card">
        <h2 class="card-title">商品品項</h2>
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">商品</th>
                        <th scope="col">規格</th>
                        <th scope="col">數量</th>
                        <th scope="col">單價</th>
                        <th scope="col">小計</th>
                        <th scope="col">狀態</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.SkuName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPriceText</td>
                            <td>@item.LineTotalText</td>
                            <td>@item.StockStatusText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="card order-summary-card">
        <h2 class="card-title">訂單摘要</h2>
        <dl class="summary-list">
            <div>
                <dt>商品小計</dt>
                <dd>@Model.SubtotalText</dd>
            </div>
            <div>
                <dt>優惠折扣</dt>
                <dd>@Model.DiscountTotalText</dd>
            </div>
            <div>
                <dt>預估總額</dt>
                <dd>@Model.EstimatedTotalText</dd>
            </div>
        </dl>
        @if (Model.CanCheckout)
        {
            <a class="btn btn-primary" asp-controller="Checkout" asp-action="Index">前往結帳</a>
        }
    </aside>
</section>
