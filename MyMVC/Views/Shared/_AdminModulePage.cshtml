@model MyWeb.Models.ViewModels.Admin.AdminModulePageViewModel

<header class="admin-hero admin-module-hero">
    <div>
        <p class="admin-eyebrow">@Model.PermissionName</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    @if (Model.CanUsePrimaryAction)
    {
        <button type="button" class="admin-primary-button" disabled>@Model.PrimaryActionText</button>
    }
</header>

@if (Model.Metrics.Count > 0)
{
    <section class="admin-stat-grid" aria-label="@Model.Title 指標">
        @foreach (var metric in Model.Metrics)
        {
            <article class="admin-stat-card admin-stat-@metric.Variant">
                <div class="admin-stat-label">@metric.Label</div>
                <div class="admin-stat-value">@metric.Value</div>
                <div class="admin-stat-note">@metric.Note</div>
            </article>
        }
    </section>
}

@if (Model.WorkflowColumns.Count > 0)
{
    <section class="admin-workflow-board" aria-label="@Model.Title 流程">
        @foreach (var column in Model.WorkflowColumns)
        {
            <div class="admin-workflow-column">
                <div class="admin-workflow-header">
                    <span>@column.Title</span>
                    <strong>@column.Items.Count</strong>
                </div>
                <div class="admin-workflow-cards">
                    @foreach (var item in column.Items)
                    {
                        <article class="admin-workflow-card">
                            <strong>@item.Title</strong>
                            <p>@item.Description</p>
                            <span class="admin-badge admin-badge-@item.BadgeVariant">@item.BadgeText</span>
                        </article>
                    }
                </div>
            </div>
        }
    </section>
}

<section class="admin-panel">
    <div class="admin-panel-header">
        <div>
            <h2>@Model.Title</h2>
            <p>列表資料將由正式 Service / API 提供，並依權限與分頁條件查詢。</p>
        </div>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col" class="admin-table-icon-col"></th>
                    @foreach (var column in Model.Columns)
                    {
                        <th scope="col">@column</th>
                    }
                    <th scope="col">標記</th>
                    <th scope="col">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="@(Model.Columns.Count + 3)">
                            <div class="admin-empty-state">
                                <strong>@Model.EmptyStateTitle</strong>
                                <span>@Model.EmptyStateDescription</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="admin-table-icon">@row.LeadingIcon</td>
                            @foreach (var cell in row.Cells)
                            {
                                <td>@cell</td>
                            }
                            <td>
                                <span class="admin-badge admin-badge-@row.StatusVariant">@row.StatusText</span>
                            </td>
                            <td>
                                <button type="button" class="admin-table-action" disabled>@row.ActionText</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
