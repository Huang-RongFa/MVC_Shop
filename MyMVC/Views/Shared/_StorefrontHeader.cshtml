@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<nav class="top-nav storefront-nav">
    <div class="nav-container">
        <div class="nav-left">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="MVC Shop 首頁">
                <span class="brand-mark">MS</span>
                <span>MVC Shop</span>
            </a>
            <div class="nav-menu">
                <a class="nav-link" asp-controller="Home" asp-action="Index">首頁</a>
                <a class="nav-link" asp-controller="Products" asp-action="Index">商品</a>
                <a class="nav-link" asp-controller="Home" asp-action="About">關於我們</a>
                @if (isAuthenticated)
                {
                    <a class="nav-link" asp-controller="Orders" asp-action="Index">我的訂單</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Profile">會員資料</a>
                }
            </div>
        </div>
        <div class="nav-right">
            @await Html.PartialAsync("_ThemeToggle")
            @if (isAuthenticated)
            {
                <a class="btn btn-secondary btn-icon cart-icon-btn"
                   asp-controller="Cart"
                   asp-action="Index"
                   aria-label="購物車"
                   title="購物車">
                    <i class="bi bi-cart3" aria-hidden="true"></i>
                </a>
                <form class="nav-inline-form" method="post" asp-controller="Account" asp-action="Logout">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-ghost logout-btn" type="submit">登出</button>
                </form>
            }
            else
            {
                <a class="btn btn-ghost" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/products">登入</a>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">註冊</a>
            }
            <button class="mobile-menu-btn" type="button" onclick="toggleMobileMenu()" aria-label="開啟選單">
                <span class="mobile-menu-line"></span>
                <span class="mobile-menu-line"></span>
                <span class="mobile-menu-line"></span>
            </button>
        </div>
    </div>
</nav>
