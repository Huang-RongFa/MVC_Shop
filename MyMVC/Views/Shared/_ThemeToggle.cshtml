<div class="theme-toggle" aria-label="切換顯示主題">
    <button type="button"
            class="theme-btn theme-btn-snow"
            data-theme-button="snow"
            onclick="setTheme('snow')"
            aria-label="明亮模式"
            title="明亮模式">
        <i class="bi bi-brightness-high" aria-hidden="true"></i>
    </button>
    <button type="button"
            class="theme-btn theme-btn-carbon"
            data-theme-button="carbon"
            onclick="setTheme('carbon')"
            aria-label="深色模式"
            title="深色模式">
        <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
    </button>
</div>
