@functions {
    private bool CanSee(string permission)
    {
        return User.HasClaim("Permission", permission)
            || User.IsInRole("Admin")
            || User.IsInRole("Manager");
    }
}

<nav class="top-nav admin-nav">
    <div class="nav-container">
        <div class="nav-left">
            <a class="brand" asp-controller="Admin" asp-action="Index" aria-label="MVC Shop 後台總覽">
                <span class="brand-mark">MS</span>
                <span>MVC Shop Admin</span>
            </a>
            <div class="nav-menu">
                @if (CanSee("Dashboard.Read"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a>
                }
                @if (CanSee("Analytics.Read"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Analytics">數據分析</a>
                }
                @if (CanSee("Products.Read"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Products">商品</a>
                }
                @if (CanSee("Inventory.Read"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Inventory">庫存</a>
                }
                @if (CanSee("Orders.Read"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Orders">訂單</a>
                }
                @if (CanSee("AuditLogs.Read"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="AuditLogs">稽核</a>
                }
            </div>
        </div>
        <div class="nav-right">
            <span class="nav-link admin-user-name">@User.Identity?.Name</span>
            @await Html.PartialAsync("_ThemeToggle")
            <button class="btn btn-ghost" type="button" onclick="adminAuth.logout()">登出</button>
            <button class="mobile-menu-btn" type="button" onclick="toggleMobileMenu()" aria-label="開啟後台選單">
                <span class="mobile-menu-line"></span>
                <span class="mobile-menu-line"></span>
                <span class="mobile-menu-line"></span>
            </button>
        </div>
    </div>
</nav>
