@{
    ViewData["MenuArea"] = "Storefront";
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MVC Shop 新鮮蔬果與家庭食材電商。" />
    <title>@ViewData["Title"] - MVC Shop</title>
    <script>
        if (localStorage.getItem("daynight-theme") === "carbon") {
            document.documentElement.classList.add("carbon");
        }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/daynight.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container storefront-shell">
        @await Html.PartialAsync("_StorefrontHeader")
        @await Html.PartialAsync("_MobileMenu")

        <main class="main-content storefront-main" role="main">
            @RenderBody()
        </main>

        <footer class="footer storefront-footer">
            <div class="footer-grid">
                <div>
                    <strong>MVC Shop</strong>
                    <p>前台專注商品展示、購物車、結帳與會員訂單。</p>
                </div>
                <div>
                    <a asp-controller="Home" asp-action="About">關於我們</a>
                    <a asp-controller="Home" asp-action="Privacy">隱私權政策</a>
                    <a asp-controller="Admin" asp-action="Login">後台登入</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/daynight.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
