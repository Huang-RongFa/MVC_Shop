@using MyWeb.Application.Security
@{
    ViewData["MenuArea"] = "Admin";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var displayName = User.Identity?.Name ?? "管理員";

    bool CanSee(string permission)
    {
        return User.Claims.Any(claim =>
            string.Equals(claim.Type, AdminClaimTypes.Permission, StringComparison.OrdinalIgnoreCase)
            && string.Equals(claim.Value, permission, StringComparison.OrdinalIgnoreCase));
    }

    bool IsActive(string action)
    {
        return string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] - FreshMart Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Noto+Sans+TC:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="freshmart-admin-body">
    <div class="admin-mobile-backdrop" id="adminMobileBackdrop" onclick="closeAdminSidebar()" aria-hidden="true"></div>

    <div class="freshmart-admin-app">
        <aside class="freshmart-admin-sidebar" id="adminSidebar" aria-label="後台管理選單">
            <div class="admin-brand-block">
                <a class="admin-brand" asp-controller="Admin" asp-action="Index">
                    <span class="admin-brand-mark">🌿</span>
                    <span>
                        <strong>FreshMart</strong>
                        <small>Admin Console</small>
                    </span>
                </a>
                <button class="admin-sidebar-close" type="button" onclick="closeAdminSidebar()" aria-label="關閉後台選單">×</button>
            </div>

            <nav class="admin-menu" aria-label="後台功能">
                @if (CanSee("Dashboard.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Index") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Index">
                        <span>🏠</span><span>營運總覽</span>
                    </a>
                }

                @if (CanSee("Products.Read")
                    || CanSee("Products.Write")
                    || CanSee("Inventory.Read")
                    || CanSee("Orders.Read")
                    || CanSee("Payments.Read")
                    || CanSee("Shipments.Manage")
                    || CanSee("Refunds.Manage"))
                {
                    <div class="admin-menu-heading">商品與交易</div>
                }
                @if (CanSee("Products.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Products") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Products">
                        <span>🥭</span><span>商品管理</span>
                    </a>
                }
                @if (CanSee("Products.Write"))
                {
                    <a class="admin-menu-link @(IsActive("ProductSkus") ? "active" : string.Empty)" asp-controller="Admin" asp-action="ProductSkus">
                        <span>🏷</span><span>SKU 管理</span>
                    </a>
                }
                @if (CanSee("Inventory.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Inventory") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Inventory">
                        <span>📦</span><span>庫存管理</span>
                    </a>
                }
                @if (CanSee("Orders.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Orders") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Orders">
                        <span>🧾</span><span>訂單管理</span>
                    </a>
                }
                @if (CanSee("Payments.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Payments") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Payments">
                        <span>💳</span><span>付款管理</span>
                    </a>
                }
                @if (CanSee("Shipments.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Shipments") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Shipments">
                        <span>🚚</span><span>出貨管理</span>
                    </a>
                }
                @if (CanSee("Refunds.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Refunds") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Refunds">
                        <span>↩</span><span>退款管理</span>
                    </a>
                }

                @if (CanSee("Analytics.Read")
                    || CanSee("Coupons.Manage")
                    || CanSee("Promotions.Manage")
                    || CanSee("Messages.Read"))
                {
                    <div class="admin-menu-heading">行銷與洞察</div>
                }
                @if (CanSee("Analytics.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Analytics") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Analytics">
                        <span>📈</span><span>數據分析</span>
                    </a>
                }
                @if (CanSee("Coupons.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Coupons") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Coupons">
                        <span>🎟</span><span>優惠券</span>
                    </a>
                }
                @if (CanSee("Promotions.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Promotions") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Promotions">
                        <span>🔥</span><span>促銷活動</span>
                    </a>
                }
                @if (CanSee("Messages.Read"))
                {
                    <a class="admin-menu-link @(IsActive("Inbox") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Inbox">
                        <span>✉️</span><span>訊息通知</span>
                    </a>
                }

                @if (CanSee("Users.Manage")
                    || CanSee("Roles.Manage")
                    || CanSee("AuditLogs.Read")
                    || CanSee("Settings.Manage"))
                {
                    <div class="admin-menu-heading">權限與系統</div>
                }
                @if (CanSee("Users.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Users") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Users">
                        <span>👤</span><span>使用者</span>
                    </a>
                }
                @if (CanSee("Roles.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Roles") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Roles">
                        <span>🛡</span><span>角色權限</span>
                    </a>
                }
                @if (CanSee("AuditLogs.Read"))
                {
                    <a class="admin-menu-link @(IsActive("AuditLogs") ? "active" : string.Empty)" asp-controller="Admin" asp-action="AuditLogs">
                        <span>🔍</span><span>稽核紀錄</span>
                    </a>
                }
                @if (CanSee("Settings.Manage"))
                {
                    <a class="admin-menu-link @(IsActive("Settings") ? "active" : string.Empty)" asp-controller="Admin" asp-action="Settings">
                        <span>⚙</span><span>系統設定</span>
                    </a>
                }
            </nav>
        </aside>

        <div class="freshmart-admin-content">
            <header class="freshmart-admin-topbar">
                <button class="admin-icon-button" type="button" onclick="openAdminSidebar()" aria-label="開啟後台選單">☰</button>
                <div>
                    <div class="admin-topbar-eyebrow">受限存取</div>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="admin-topbar-actions">
                    <a class="admin-ghost-link" asp-controller="Home" asp-action="Index">前台首頁</a>
                    <div class="admin-user-chip">
                        <span class="admin-user-avatar">@displayName[..1].ToUpperInvariant()</span>
                        <span>@displayName</span>
                    </div>
                    <button class="admin-logout-button" type="button" onclick="adminAuth.logout()">登出</button>
                </div>
            </header>

            <main class="freshmart-admin-main" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/admin/assets/admin-auth.js" asp-append-version="true"></script>
    <script src="~/admin/assets/admin-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
